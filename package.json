{
  "name": "qfqa",
  "version": "2.0.0-optimized",
  "description": "QFQA - Emploi du temps adapté aux neurodivergents",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:vanilla && npm run build:css",
    "build:vanilla": "sass src/vanilla-custom.scss public/css/vanilla-custom.css --style compressed --no-source-map",
    "build:css": "echo 'CSS custom déjà optimisé'",
    "dev": "npm run build && python -m http.server 8000 -d public",
    "watch": "sass --watch src/vanilla-custom.scss:public/css/vanilla-custom.css --style compressed --no-source-map"
  },
  "keywords": ["neurodivergent", "TDAH", "autisme", "emploi-du-temps", "accessibilité"],
  "author": "QFQA Team",
  "license": "MIT",
  "devDependencies": {
    "sass": "^1.69.5"
  },
  "dependencies": {
    "vanilla-framework": "^4.13.0"
  }
}